# ================================================================
# ChatSaints API environment
#
# Copy to .env and fill in real values:  cp .env.example .env
#
# .env is gitignored and must stay that way. Never commit a real
# credential to this repository, not even a local one.
# ================================================================

# ── Server ──────────────────────────────────────────────────────
PORT=4000
# Must be exactly "production" in production. Several behaviours key off it.
NODE_ENV=development

# Comma-separated list of allowed browser origins.
# Leave empty to allow no cross-origin browser requests.
# Do NOT use "*" here: credentials are sent with requests.
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ───────────────────────────────────────
# Prisma reads this. It is the only database setting the app needs.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chatsaints

# Optional. Only set this on managed Postgres where the user above cannot
# CREATE DATABASE. Locally, leave it unset and Prisma manages the shadow
# database itself.
# SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chatsaints_shadow

# ── Redis (presence, caching) ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────────
# Generate a fresh one per environment:
#   openssl rand -hex 64
# The server refuses to start if this is missing or shorter than 32 chars.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Email (one-time codes) ──────────────────────────────────────
#
# LEAVE THESE EMPTY FOR LOCAL DEVELOPMENT.
#
# With no SMTP configured and NODE_ENV != production, verification codes are
# printed to the terminal running the server instead of being emailed:
#
#   ────────────────────────────────────────────
#     DEV EMAIL - not sent, SMTP is unconfigured
#     To:       someone@example.org
#     CODE:     392518
#   ────────────────────────────────────────────
#
# So registration and sign-in work with no mail provider and no spend. The code
# is NEVER returned in an HTTP response, in any environment.
#
# In production, missing SMTP is a hard 503 rather than a fallback.
#
# Any provider works. Use either the URL form or the discrete settings.
# SMTP_URL=smtps://user:pass@mail.example.org:465
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. "ChatSaints" <no-reply@example.org>
MAIL_FROM=

# ── File storage ────────────────────────────────────────────────
# local | s3
# "local" writes to LOCAL_UPLOAD_PATH on disk and costs nothing. Files are
# served by an authenticated route, never by a public static path.
STORAGE_TYPE=local
LOCAL_UPLOAD_PATH=./uploads
# Only needed when STORAGE_TYPE=s3
AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Media processing ────────────────────────────────────────────
# Images are resized, re-encoded and stripped of metadata once at upload, so
# every later view is cheaper. EXIF stripping also removes GPS coordinates that
# phone cameras embed in photos.
#
# Upload ceiling in megabytes, enforced mid-stream.
MEDIA_MAX_UPLOAD_MB=50
# Chat media: longest edge, and JPEG/WebP quality (1-100).
MEDIA_IMAGE_MAX_DIMENSION=1920
MEDIA_IMAGE_QUALITY=80
# Profile photos are displayed small, so they are capped harder.
# Upload one with POST /api/media/upload?purpose=avatar
MEDIA_AVATAR_MAX_DIMENSION=512
MEDIA_AVATAR_QUALITY=80

# ── Push notifications ──────────────────────────────────────────
# Path to the Firebase service account JSON. The file itself is gitignored.
# Firebase Console -> Project Settings -> Service accounts -> Generate key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# ── Video calls (LiveKit) ───────────────────────────────────────
# Leave empty to disable video calling. It will report as unavailable rather
# than silently issuing fake tokens.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Missionary device management (MaaS360) ──────────────────────
# Leave empty to disable. Enrollment will report as unavailable rather than
# reporting success without doing anything.
MAAS360_TENANT_ID=
MAAS360_USERNAME=
MAAS360_PASSWORD=
MAAS360_APP_ID=
MAAS360_APP_ACCESS_KEY=

# ── App limits ──────────────────────────────────────────────────
MAX_GROUP_SIZE=1000
MAX_PINNED_CHATS=3
SCRIPTURE_ROTATE_MINS=5
