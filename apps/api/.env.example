# ================================================================
# ChatSaints API environment
#
# Copy to .env and fill in real values:  cp .env.example .env
#
# .env is gitignored and must stay that way. Never commit a real
# credential to this repository, not even a local one.
# ================================================================

# ── Server ──────────────────────────────────────────────────────
PORT=4000
# Must be exactly "production" in production. Several behaviours key off it.
NODE_ENV=development

# Comma-separated list of allowed browser origins.
# Leave empty to allow no cross-origin browser requests.
# Do NOT use "*" here: credentials are sent with requests.
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ───────────────────────────────────────
# Prisma reads this. It is the only database setting the app needs.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chatsaints

# Optional. Only set this on managed Postgres where the user above cannot
# CREATE DATABASE. Locally, leave it unset and Prisma manages the shadow
# database itself.
# SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chatsaints_shadow

# ── Redis (presence, caching) ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────────
# Generate a fresh one per environment:
#   openssl rand -hex 64
# The server refuses to start if this is missing or shorter than 32 chars.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Email (OTP delivery) ────────────────────────────────────────
# Any provider works. Use either the URL form or the discrete settings.
# SMTP_URL=smtps://user:pass@mail.example.org:465
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. "ChatSaints" <no-reply@example.org>
MAIL_FROM=

# ── File storage ────────────────────────────────────────────────
# local | s3
STORAGE_TYPE=local
LOCAL_UPLOAD_PATH=./uploads
# Only needed when STORAGE_TYPE=s3
AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Push notifications ──────────────────────────────────────────
# Path to the Firebase service account JSON. The file itself is gitignored.
# Firebase Console -> Project Settings -> Service accounts -> Generate key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# ── Video calls (LiveKit) ───────────────────────────────────────
# Leave empty to disable video calling. It will report as unavailable rather
# than silently issuing fake tokens.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Missionary device management (MaaS360) ──────────────────────
# Leave empty to disable. Enrollment will report as unavailable rather than
# reporting success without doing anything.
MAAS360_TENANT_ID=
MAAS360_USERNAME=
MAAS360_PASSWORD=
MAAS360_APP_ID=
MAAS360_APP_ACCESS_KEY=

# ── App limits ──────────────────────────────────────────────────
MAX_GROUP_SIZE=1000
MAX_PINNED_CHATS=3
SCRIPTURE_ROTATE_MINS=5
